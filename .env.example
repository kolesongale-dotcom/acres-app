# Copy to .env for local development. In the cloud (Railway) set these as
# service variables instead of committing them.

# --- Database ---
# Local: a SQLite file under prisma/. Cloud: a file on the persistent volume.
#   local:  file:./dev.db
#   cloud:  file:/data/dev.db
DATABASE_URL="file:./dev.db"

# --- Authentication (back-office login) ---
# Leave APP_PASSWORD empty to DISABLE the login gate (good for local dev).
# Set it in the cloud to require a password before anyone can see the back office.
# AUTH_SECRET should be a long random string (the value stored in the login cookie).
APP_PASSWORD=""
AUTH_SECRET="change-me-to-a-long-random-string"

# --- File uploads ---
# Where photos/logos are written. Defaults to ./uploads when unset.
#   cloud:  /data/uploads   (on the Railway volume)
# UPLOAD_DIR="./uploads"
